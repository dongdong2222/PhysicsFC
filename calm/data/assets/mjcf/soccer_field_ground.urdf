<?xml version="1.0"?>
<robot name="object">
  <link name="field">
    <visual>
      <origin xyz="0 0 -0.001"/>
      <geometry>
        <mesh filename="soccer_field_ground.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="soccer_field_ground.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
</robot>
